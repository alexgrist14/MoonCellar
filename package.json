{
  "name": "mooncellar",
  "private": true,
  "packageManager": "bun@1.3.12",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^26.1.1",
      "axios": "^1.18.1",
      "eslint": "9.39.5",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.6",
      "jwt-decode": "^4.0.0",
      "typescript": "5.9.3",
      "typescript-eslint": "^8.64.0",
      "zod": "^4.4.3"
    }
  },
  "scripts": {
    "dev": "bun --filter @mooncellar/schemas build && (bun run dev:schemas & bun run dev:api & bun run dev:web & wait)",
    "dev:schemas": "bun --filter @mooncellar/schemas dev",
    "dev:api": "bun --filter api start:dev",
    "dev:web": "bun --filter web dev",
    "build": "bun --filter '*' build",
    "lint": "bun --filter '*' lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.9.5"
  }
}
