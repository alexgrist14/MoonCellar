{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "mongodb": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server@latest",
        "--readOnly"
      ]
    },
    "game-adder": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "--env-file=apps/api/.env",
        "apps/api/mcp/game-adder/index.ts"
      ]
    }
  }
}
