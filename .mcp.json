{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "mongodb": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server@latest",
        "--readOnly"
      ]
    },
    "game-adder": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "--env-file=apps/api/.env",
        "apps/api/mcp/game-adder/index.ts"
      ]
    },
    "grafana": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL=https://grafana.mooncellar.space",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "mcp/grafana",
        "-t",
        "stdio",
        "-disable-write",
        "-disable-asserts",
        "-disable-athena",
        "-disable-clickhouse",
        "-disable-cloudwatch",
        "-disable-elasticsearch",
        "-disable-graphite",
        "-disable-influxdb",
        "-disable-incident",
        "-disable-oncall",
        "-disable-pyroscope",
        "-disable-quickwit",
        "-disable-snowflake",
        "-disable-sift"
      ]
    }
  }
}
